{
    "name": "abetwothree/lang-export",
    "description": "Export your Laravel translation files as JSON for Vue, React, & Svelte with @tolki/lang",
    "keywords": [
        "abetwothree",
        "laravel",
        "lang-export",
        "translations",
        "i18n",
        "tolki"
    ],
    "homepage": "https://github.com/abetwothree/laravel-lang",
    "license": "MIT",
    "authors": [
        {
            "name": "Abraham Arango",
            "email": "skat_et_dieu@yahoo.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^13.0||^12.0"
    },
    "require-dev": {
        "brianium/paratest": "!=7.26.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0||^10.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AbeTwoThree\\LangExport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AbeTwoThree\\LangExport\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --verbose --ansi --memory-limit=-1",
        "test": "php -d memory_limit=-1 vendor/bin/pest --parallel --tia --passthru-php=\"'-d' 'memory_limit=-1'\"",
        "test-cov": "export XDEBUG_MODE=coverage && php -d memory_limit=-1 vendor/bin/pest --parallel --tia --coverage --coverage-clover coverage.xml --passthru-php=\"'-d' 'memory_limit=-1'\"",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "lint": [
            "@php vendor/bin/pint --ansi",
            "@php vendor/bin/phpstan analyse --verbose --ansi --memory-limit=-1"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AbeTwoThree\\LangExport\\LangExportServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
